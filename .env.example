# AfriHealth Assistant — environment variables
# Copy this file to .env and adjust as needed. No secrets are required for
# the frontend-only build; these are placeholders for when the backend
# (FastAPI + llama.cpp + RAG) is connected.

# AfriHealth Assistant — environment variables
# Copy this file to .env and adjust as needed. No secrets are required for
# the frontend-only build; these are placeholders for when the backend
# (FastAPI + llama.cpp + RAG) is connected.

# Model Configuration — Local or Remote
# For ONLINE deployment: leave MODEL_PATH empty and set LLM_PROVIDER to "huggingface" or "gemini"
# For OFFLINE deployment: set MODEL_PATH to local GGUF file and set LLM_PROVIDER to "local"
MODEL_PATH=
LLM_PROVIDER=huggingface
HUGGINGFACE_API_KEY=hf_YOUR_API_KEY_HERE
HUGGINGFACE_MODEL_ID=meta-llama/Llama-2-7b-chat-hf
GROQ_API_KEY=
EMBEDDING_MODEL=backend/models/embedding/all-MiniLM-L6-v2

# Database Configuration
DB_PATH=backend/data/afrihealth.db

# RAG Configuration
VECTOR_DB_PATH=backend/data/vector_db/chroma_db
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# LLM Parameters
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=512
DEFAULT_TOP_P=0.9
NUM_THREADS=4
CONTEXT_LENGTH=2048

# Frontend -> Backend connection
BACKEND_BASE_URL=http://localhost:8000
BACKEND_CONNECTED=True

# CORS: exact origins may be comma-separated. The default regex also allows
# localhost/127.0.0.1 on any development port; clear it for strict production.
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# Optional Gemini fallback. Keep empty for fully local operation.
GEMINI_API_KEY=
SECRET_KEY=change-this-in-a-local-secrets-file

# Password recovery
# local = one-time token is returned for offline use; email = SMTP delivery only
AUTH_RECOVERY_MODE=local
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_ADMIN_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Application Settings
APP_NAME=AfriHealth Assistant
APP_VERSION=1.0.0
DEBUG=False
